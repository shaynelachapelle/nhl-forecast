# Copy to .env.local for local development. Never put prod credentials in a file.
#
# Local Supabase, as the read-only web_reader role. Give it this local-only password once:
#   psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -c "alter role web_reader password 'web_reader_local'"
DATABASE_URL=postgresql://web_reader:web_reader_local@127.0.0.1:54322/postgres

# Vercel (Production and Preview, marked Sensitive) uses the transaction pooler instead:
#   postgresql://web_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
